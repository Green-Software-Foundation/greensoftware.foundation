---
import Image from "@/components/image.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

interface Feature {
  icon?: string;
  title: string;
  description: string;
  /** HTML description (rendered with set:html, used instead of description when provided) */
  descriptionHtml?: string;
  /** Small pill label shown above the title */
  badge?: string;
  linkText?: string;
  linkHref?: string;
  /** Highlight this card with inverted (dark) styling */
  featured?: boolean;
}

interface Stat {
  value: string;
  label: string;
}

interface Quote {
  text: string;
  author?: string;
  role?: string;
}

interface Props {
  /** Heading text. Wrap words in *asterisks* for accent colour */
  heading?: string;
  /** Body text under heading */
  body?: string;
  /** HTML body (rendered with set:html, used instead of body when provided) */
  bodyHtml?: string;
  /** Array of feature items */
  features?: Feature[];
  /** Number of columns (2, 3, 4, or 5) */
  columns?: 2 | 3 | 4 | 5;
  /** Display variant: "cards" (default), "bordered" (centred card with bordered grid), "plain" (left-aligned with vertical dividers), or "panel" (large dark feature panel: eyebrow, heading, stats, white cards, quote and CTAs) */
  variant?: "cards" | "bordered" | "plain" | "panel";
  /** Reduce vertical padding (useful when used as a section heading) */
  compact?: boolean;
  /** Background class */
  bgClass?: string;
  /** How each feature's link renders: "link" (default, text link) or "button" (primary button, aligned to the bottom of the card) */
  linkStyle?: "link" | "button";
  /** Optional section-level call to action, shown under the grid inside the same container (cards and bordered variants) */
  ctaText?: string;
  ctaHref?: string;
  /** Short line shown above the section-level button */
  ctaLeadIn?: string;
  /** Second, outlined section-level button (panel variant) */
  ctaSecondaryText?: string;
  ctaSecondaryHref?: string;
  /** Small uppercase label above the heading (panel variant) */
  eyebrow?: string;
  /** Headline numbers shown under the heading (panel variant) */
  stats?: Stat[];
  /** Pull quote shown under the cards (panel variant) */
  quote?: Quote;
}

const cardColumnClasses: Record<number, string> = {
  2: "sm:grid-cols-2",
  3: "sm:grid-cols-2 lg:grid-cols-3",
  4: "sm:grid-cols-2 lg:grid-cols-4",
  5: "sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5",
};

const borderedColumnClasses: Record<number, string> = {
  2: "md:grid-cols-2",
  3: "md:grid-cols-2 lg:grid-cols-3",
  4: "md:grid-cols-2 lg:grid-cols-4",
  5: "md:grid-cols-3 lg:grid-cols-5",
};

// Actual column counts at each responsive breakpoint for bordered variant border logic
const borderedMdCols: Record<number, number> = { 2: 2, 3: 2, 4: 2, 5: 3 };
const borderedLgCols: Record<number, number> = { 2: 2, 3: 3, 4: 4, 5: 5 };

const {
  heading = "",
  body,
  bodyHtml,
  features = [],
  columns = 3,
  variant = "cards",
  compact = false,
  bgClass = "bg-accent-lightest-2",
  linkStyle = "link",
  ctaText,
  ctaHref,
  ctaLeadIn,
  ctaSecondaryText,
  ctaSecondaryHref,
  eyebrow,
  stats = [],
  quote,
} = Astro.props;

const asButton = linkStyle === "button";
const buttonClass = (featured = false) =>
  cn(
    buttonVariants({ variant: featured ? "primary-invert" : "primary" }),
    "whitespace-normal text-left",
  );

// Compute responsive border classes for bordered variant
const mdCols = borderedMdCols[columns] ?? columns;
const lgCols = borderedLgCols[columns] ?? columns;

function borderedBorderClasses(index: number): string[] {
  const classes: string[] = [];
  const mdLeft = index % mdCols !== 0;
  const lgLeft = index % lgCols !== 0;
  const mdTop = index >= mdCols;
  const lgTop = index >= lgCols;

  if (mdLeft && lgLeft) classes.push("md:border-l");
  else if (mdLeft && !lgLeft) classes.push("md:border-l", "lg:border-l-0");
  else if (!mdLeft && lgLeft) classes.push("lg:border-l");

  if (mdTop && lgTop) classes.push("md:border-t");
  else if (mdTop && !lgTop) classes.push("md:border-t", "lg:border-t-0");
  else if (!mdTop && lgTop) classes.push("lg:border-t");

  return classes;
}

// Split heading into plain and accent segments
const headingParts = heading.split(/(\*[^*]+\*)/g).filter(Boolean).map(part => {
  if (part.startsWith("*") && part.endsWith("*")) {
    return { text: part.slice(1, -1), accent: true };
  }
  return { text: part, accent: false };
});
---

<section class={`${compact ? "py-8 md:py-10" : "py-16 md:py-20"} ${bgClass}`}>
  <div class="container">
    {variant === "bordered" && (
      <div class="rounded-2xl bg-accent-lighter/50 p-8 md:px-16 md:py-12 lg:px-20 lg:py-16">
        <div class="mx-auto max-w-5xl text-center">
          <h2 class="text-2xl font-semibold md:text-3xl lg:text-4xl">
            {headingParts.map(part =>
              part.accent
                ? <span class="font-bold text-primary">{part.text}</span>
                : part.text
            )}
          </h2>
          {body && (
            <p class="mt-4 text-lg md:text-xl">{body}</p>
          )}
        </div>
        <div class={`mt-8 grid grid-cols-1 md:mt-10 lg:mt-12 ${borderedColumnClasses[columns]}`}>
          {features.map((feature, index) => (
            <div class:list={[
              "relative px-2 py-6 md:p-10",
              "border-primary-lighter",
              ...borderedBorderClasses(index),
            ]}>
              <div class:list={["flex flex-col items-start", asButton && "h-full"]}>
                {feature.icon && (
                  <Image src={feature.icon} alt="" class="mb-3 h-12 w-12 md:mb-4" sizes="48px" />
                )}
                {feature.badge && (
                  <span class="mb-2 inline-block rounded-full bg-accent-lighter px-3 py-1 text-xs font-semibold text-accent-darker">{feature.badge}</span>
                )}
                <h3 class="text-xl font-semibold text-primary">{feature.title}</h3>
                {feature.descriptionHtml ? (
                  <div set:html={feature.descriptionHtml} class="mt-2" />
                ) : (
                  <p class="mt-2">{feature.description}</p>
                )}
                {feature.linkText && (asButton ? (
                  <div class="mt-auto pt-5">
                    <a href={feature.linkHref || "#"} class={buttonClass()}>{feature.linkText}</a>
                  </div>
                ) : (
                  <a href={feature.linkHref || "#"} class="mt-3 inline-flex items-center text-sm font-bold text-primary hover:underline">
                    {feature.linkText}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
        {ctaText && (
          <div class="mt-8 border-t border-primary-lighter pt-8 text-center md:mt-10 md:pt-10">
            {ctaLeadIn && <p class="mx-auto mb-5 max-w-2xl text-lg">{ctaLeadIn}</p>}
            <a href={ctaHref || "#"} class={cn(buttonVariants({ variant: "primary", size: "lg" }), "h-12 whitespace-normal text-base")}>{ctaText}</a>
          </div>
        )}
      </div>
    )}

    {variant === "cards" && (
      <>
        <h2 class="text-center text-2xl font-semibold md:text-3xl lg:text-4xl">
          {headingParts.map(part =>
            part.accent
              ? <span class="font-bold text-primary">{part.text}</span>
              : part.text
          )}
        </h2>
        {body && (
          <p class="mx-auto mt-4 max-w-2xl text-center text-base text-primary-dark">{body}</p>
        )}
        <div class={`mt-12 grid gap-6 ${cardColumnClasses[columns]}`}>
          {features.map((feature) => (
            <div class:list={[
              "rounded-lg border p-5 shadow-sm",
              asButton && "flex flex-col",
              feature.featured ? "bg-primary-darker border-primary-darker" : "bg-white",
            ]}>
              {feature.icon && <Image src={feature.icon} alt="" class="mb-4 h-10 w-10" sizes="40px" />}
              {feature.badge && (
                <span class="mb-3 inline-block self-start rounded-full bg-accent-lighter px-3 py-1 text-xs font-semibold text-accent-darker">{feature.badge}</span>
              )}
              <h3 class:list={["text-lg font-bold", feature.featured ? "text-white" : "text-primary"]}>{feature.title}</h3>
              {feature.descriptionHtml ? (
                <div set:html={feature.descriptionHtml} class:list={["mt-2 text-sm", feature.featured ? "text-white/70" : "text-gray-darker"]} />
              ) : (
                <p class:list={["mt-2 text-sm", feature.featured ? "text-white/70" : "text-gray-darker"]}>{feature.description}</p>
              )}
              {feature.linkText && (asButton ? (
                <div class="mt-auto pt-5">
                  <a href={feature.linkHref || "#"} class={buttonClass(feature.featured)}>{feature.linkText}</a>
                </div>
              ) : (
                <a href={feature.linkHref || "#"} class:list={["mt-3 inline-flex items-center text-sm font-bold hover:underline", feature.featured ? "text-accent" : "text-primary"]}>
                  {feature.linkText}
                </a>
              ))}
            </div>
          ))}
        </div>
        {ctaText && (
          <div class="mt-10 text-center">
            {ctaLeadIn && <p class="mx-auto mb-5 max-w-2xl text-base text-primary-dark">{ctaLeadIn}</p>}
            <a href={ctaHref || "#"} class={cn(buttonVariants({ variant: "primary", size: "lg" }), "h-12 whitespace-normal text-base")}>{ctaText}</a>
          </div>
        )}
      </>
    )}

    {variant === "panel" && (
      <div class="overflow-hidden rounded-3xl bg-primary-darker px-5 py-10 text-white md:px-8 md:py-14 lg:px-10 lg:py-16">
        <div class="mx-auto max-w-4xl text-center">
          {eyebrow && (
            <span class="mb-4 inline-block rounded-full bg-white/10 px-4 py-1.5 text-xs font-semibold tracking-wider text-accent uppercase">{eyebrow}</span>
          )}
          <h2 class="text-3xl font-extrabold md:text-4xl lg:text-5xl">
            {headingParts.map(part =>
              part.accent
                ? <span class="text-accent">{part.text}</span>
                : part.text
            )}
          </h2>
          {body && (
            <p class="mx-auto mt-5 max-w-3xl text-base text-white/80 md:text-lg">{body}</p>
          )}
        </div>
        {stats.length > 0 && (
          <div class="mx-auto mt-10 grid max-w-4xl grid-cols-1 gap-6 border-y border-white/15 py-8 sm:grid-cols-3">
            {stats.map((stat) => (
              <div class="text-center">
                <p class="text-4xl font-extrabold text-accent md:text-5xl">{stat.value}</p>
                <p class="mt-1 text-sm text-white/80">{stat.label}</p>
              </div>
            ))}
          </div>
        )}
        {/* Card markup mirrors the "cards" variant (white cards on the dark panel) */}
        <div class={`mt-10 grid gap-5 ${cardColumnClasses[columns]}`}>
          {features.map((feature) => (
            <div class:list={["flex flex-col rounded-xl bg-white p-5 text-gray-darker shadow-sm"]}>
              {feature.icon && <Image src={feature.icon} alt="" class="mb-4 h-10 w-10" sizes="40px" />}
              {feature.badge && (
                <span class="mb-3 inline-block self-start rounded-full bg-accent-lighter px-3 py-1 text-xs font-semibold text-accent-darker">{feature.badge}</span>
              )}
              <h3 class="text-lg font-bold text-primary">{feature.title}</h3>
              {feature.descriptionHtml ? (
                <div set:html={feature.descriptionHtml} class="mt-2 text-sm" />
              ) : (
                <p class="mt-2 text-sm">{feature.description}</p>
              )}
              {feature.linkText && (
                <div class="mt-auto pt-5">
                  <a href={feature.linkHref || "#"} class={buttonClass()}>{feature.linkText}</a>
                </div>
              )}
            </div>
          ))}
        </div>
        {quote && (
          <figure class="mx-auto mt-12 max-w-3xl text-center">
            <blockquote class="text-lg font-medium italic md:text-xl">&ldquo;{quote.text}&rdquo;</blockquote>
            {quote.author && (
              <figcaption class="mt-4 text-sm text-white/80">
                <span class="font-bold text-white">{quote.author}</span>{quote.role && <span>, {quote.role}</span>}
              </figcaption>
            )}
          </figure>
        )}
        {ctaText && (
          <div class="mx-auto mt-12 max-w-3xl border-t border-white/15 pt-10 text-center">
            {ctaLeadIn && <p class="mb-6 text-base text-white/80 md:text-lg">{ctaLeadIn}</p>}
            <div class="flex flex-wrap justify-center gap-4">
              <a href={ctaHref || "#"} class={cn(buttonVariants({ variant: "primary-invert", size: "lg" }), "h-12 whitespace-normal text-base")}>{ctaText}</a>
              {ctaSecondaryText && (
                <a href={ctaSecondaryHref || "#"} class={cn(buttonVariants({ size: "lg" }), "h-12 whitespace-normal border border-white/70 bg-transparent text-base text-white hover:bg-white/10")}>{ctaSecondaryText}</a>
              )}
            </div>
          </div>
        )}
      </div>
    )}

    {variant === "plain" && (
      <>
        <div class="max-w-3xl">
          <h2 class="text-2xl font-semibold md:text-3xl lg:text-4xl">
            {headingParts.map(part =>
              part.accent
                ? <span class="font-bold text-primary">{part.text}</span>
                : part.text
            )}
          </h2>
          {bodyHtml ? (
            <p set:html={bodyHtml} class="mt-2 text-lg lg:text-xl" />
          ) : body ? (
            <p class="mt-2 text-lg lg:text-xl">{body}</p>
          ) : null}
        </div>
        <div class={`mt-8 grid grid-cols-1 items-stretch border-0 border-primary-light/50 md:mt-10 md:grid-cols-3 md:gap-6 ${cardColumnClasses[columns]} lg:gap-0 lg:border-l`}>
          {features.map((feature, index) => (
            <div class:list={[
              "flex w-full flex-col items-start justify-start border-b border-primary-light/50 py-5 last:border-b-0 md:border-b-0 md:py-0 lg:px-6",
              index < features.length - 1 && "lg:border-r lg:border-primary-light/50",
            ]}>
              {feature.icon && (
                <div class="mb-2 md:mb-3">
                  <Image src={feature.icon} alt="" class="h-8 w-auto" sizes="32px" />
                </div>
              )}
              <h3 class="mb-2 text-lg font-semibold text-primary lg:text-xl">{feature.title}</h3>
              <p class="text-sm lg:text-base">{feature.description}</p>
            </div>
          ))}
        </div>
      </>
    )}
  </div>
</section>
