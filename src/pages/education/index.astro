---
import { getCollection } from "astro:content";
import { articleUrl } from "@/lib/utils";
import Layout from "@/layouts/showcase.astro";
import { navItems } from "@/lib/nav-items";

// Parameterised components
import Navbar from "@/components/navbar.astro";
import Hero from "@/components/hero.astro";
import FeatureGrid from "@/components/feature-grid.astro";
import ResourceCards from "@/components/resource-cards.astro";
import ArticleCarousel from "@/components/article-carousel.astro";
import CTABanner from "@/components/cta-banner.astro";
import MemberStories from "@/components/member-stories.astro";
import Footer from "@/components/footer.astro";

// ----- Articles tagged "learning" for the carousel (continued-education reading) -----
const allArticles = await getCollection("articles", (a) => a.data.published !== false);
const educationArticles = allArticles
  .filter((a: any) => {
    const tags = (a.data.tags || []).map((t: string) => t.toLowerCase());
    return tags.includes("learning");
  })
  .sort((a: any, b: any) => b.data.date.getTime() - a.data.date.getTime())
  .map((a: any) => ({
    title: a.data.title,
    description: a.data.summary || a.data.teaserText || "",
    imageSrc: a.data.mainImage?.src || undefined,
    href: articleUrl(a.id),
    cta: "Read the article →",
  }));
---

<Layout
  title="Education — Green Software Foundation"
  description="Learn green software principles through GSF's education program, from free foundation courses on the Movement Platform to professional certification through the Green Software & AI Academy."
>
  <Navbar
    logoSrc="/assets/gsf-logo-full.svg"
    logoAlt="Green Software Foundation"
    logoHref="/"
    topBar="none"
    showSearch
    navItems={navItems}
  />

  <!-- Section 1: Hero -->
  <Hero
    heading="Learn to build"
    headingAccent="greener software"
    body="Three ways to learn: free foundation courses to get started, professional certification through the Green Software & AI Academy, and practical patterns you can apply today. Whether you're just starting out or scaling green software across your organization, start where you are."
    ctas={[
      { text: "Start free", variant: "primary", href: "#foundation-courses" },
      { text: "Explore the Academy", variant: "primary", href: "#academy" },
      { text: "Explore patterns", variant: "outline", href: "#patterns" },
    ]}
    imageSrc="/assets/why-feat-1.svg"
    imageAlt="Education illustration"
    bgClass="bg-accent-lightest-2"
  />

  <!-- Section 2: Three ways to learn -->
  <FeatureGrid
    heading="Three ways to *learn*"
    body="Start with the free foundations, go professional with role-based certification, and put it all into practice with patterns."
    columns={3}
    linkStyle="button"
    features={[
      { icon: "/assets/renewable-icon.svg", badge: "Start here", title: "Foundation courses", description: "Free, self-paced courses on the Movement Platform, open to everyone. Learn the principles of green software and how to measure it, and earn a digital credential for each course.", linkText: "See the free courses →", linkHref: "#foundation-courses" },
      { icon: "/assets/standardized-icon.svg", badge: "Go professional", title: "Green Software & AI Academy", description: "Fourteen role-based courses across five tracks, from executives to engineers. Scenario-based assessment leads to a vendor-neutral GSF certification. Now in pilot with GSF member organizations.", linkText: "Explore the Academy →", linkHref: "#academy", featured: true },
      { icon: "/assets/co2-icon.svg", badge: "Put it into practice", title: "Green Software Patterns", description: "A free, open-source catalog of more than 50 peer-reviewed techniques for reducing the emissions of software across AI, cloud, and web. Each one is a concrete change you can make.", linkText: "Explore patterns →", linkHref: "#patterns" },
    ]}
  />

  <!-- Section 3: Foundation courses (compact) -->
  <div id="foundation-courses" class="scroll-mt-24"></div>
  <FeatureGrid
    heading="*Foundation* courses on the Movement Platform"
    body="Four free, self-paced courses, hosted on the Movement Platform, a community hub where you can learn, discuss, and connect with fellow practitioners."
    variant="bordered"
    columns={4}
    linkStyle="button"
    ctaLeadIn="Green Software Practitioner and SCI Fundamentals are the recommended starting point for the Academy."
    ctaText="Join the Movement Platform →"
    ctaHref="https://movement.greensoftware.foundation"
    features={[
      { badge: "Flagship course", title: "Green Software Practitioner", description: "The comprehensive introduction to building, maintaining, and running greener applications, whatever your domain or stack. Takes just a few hours, and has been completed by 145,000+ people.", linkText: "Take the course →", linkHref: "https://grnsft.org/mov-plat-gs-practitioner" },
      { badge: "Specification course", title: "SCI Fundamentals", description: "Learn how the Software Carbon Intensity equation works and how to calculate a score for your own software. About 20 minutes.", linkText: "Take the course →", linkHref: "https://grnsft.org/sci-fundamentals-course" },
      { badge: "Specification course", title: "SCI for AI Fundamentals", description: "Measure the carbon footprint of AI systems with the SCI for AI specification. 50 minutes of video across 9 modules.", linkText: "Take the course →", linkHref: "https://grnsft.org/sci-ai-fundamentals-course" },
      { badge: "Framework course", title: "SOFT Essentials", description: "The Sustainable Organizational Framework for Technology: how to embed green software practices across your whole organization.", linkText: "Take the course →", linkHref: "https://grnsft.org/mov-plat-soft-essentials" },
    ]}
  />

  <!-- Section 4: Academy — professional certification (centrepiece) -->
  <div id="academy" class="scroll-mt-24"></div>
  <FeatureGrid
    variant="panel"
    eyebrow="Professional certification"
    heading="The Green Software & AI *Academy*"
    body="Go beyond the foundations. Fourteen role-based courses across five tracks, each built around the decisions a role controls and grounded in GSF standards for carbon, energy, and water, including SCI, SCI for AI, SEI, and SWI. Every course ends in a scenario-based assessment and leads to a vendor-neutral GSF certification."
    stats={[
      { value: "14", label: "role-based courses" },
      { value: "5", label: "role tracks, from leaders to operations" },
      { value: "ISO", label: "built on SCI, published as ISO/IEC 21031:2024" },
    ]}
    columns={5}
    linkStyle="button"
    features={[
      { badge: "Lead and manage", title: "Courses for people who lead and manage", description: "Executives, sponsors, programme leads, and policymakers who set direction, budgets, and rules.", descriptionHtml: "<p>Executives, sponsors, programme leads, and policymakers who set direction, budgets, and rules.</p><ul class=\"mt-3 list-disc space-y-1.5 pl-4\"><li><a class=\"font-semibold text-primary underline underline-offset-2 hover:no-underline\" href=\"https://academy.greensoftware.foundation/course/green-it-leaders\">Green IT for Leaders</a></li><li><a class=\"font-semibold text-primary underline underline-offset-2 hover:no-underline\" href=\"https://academy.greensoftware.foundation/course/green-ai-for-executives\">Green AI for Executives</a></li><li><a class=\"font-semibold text-primary underline underline-offset-2 hover:no-underline\" href=\"https://academy.greensoftware.foundation/course/scaling-green-ai-and-software\">Scaling Green AI and Software</a></li><li><a class=\"font-semibold text-primary underline underline-offset-2 hover:no-underline\" href=\"https://academy.greensoftware.foundation/course/green-ai-for-policy-makers\">Green AI for Policy Makers</a></li></ul>", linkText: "Explore leader courses →", linkHref: "https://academy.greensoftware.foundation/" },
      { badge: "Design", title: "Courses for people who design systems", description: "Architects who shape how software and AI systems are designed, before any code is written.", descriptionHtml: "<p>Architects who shape how software and AI systems are designed, before any code is written.</p><ul class=\"mt-3 list-disc space-y-1.5 pl-4\"><li><a class=\"font-semibold text-primary underline underline-offset-2 hover:no-underline\" href=\"https://academy.greensoftware.foundation/course/green-and-efficient-architect\">Green and Efficient Architect</a></li><li><a class=\"font-semibold text-primary underline underline-offset-2 hover:no-underline\" href=\"https://academy.greensoftware.foundation/course/designing-green-agentic-systems\">Designing Green Agentic Systems</a></li></ul>", linkText: "Explore architect courses →", linkHref: "https://academy.greensoftware.foundation/" },
      { badge: "Build and measure", title: "Courses for people who build and measure", description: "Developers and engineers who build software and AI systems and measure their impact.", descriptionHtml: "<p>Developers and engineers who build software and AI systems and measure their impact.</p><ul class=\"mt-3 list-disc space-y-1.5 pl-4\"><li><a class=\"font-semibold text-primary underline underline-offset-2 hover:no-underline\" href=\"https://academy.greensoftware.foundation/course/green-software-developer\">Green Software Developer</a></li><li><a class=\"font-semibold text-primary underline underline-offset-2 hover:no-underline\" href=\"https://academy.greensoftware.foundation/course/building-a-green-ai-agent\">Building a Green AI Agent</a></li><li><a class=\"font-semibold text-primary underline underline-offset-2 hover:no-underline\" href=\"https://academy.greensoftware.foundation/course/sci-for-ai-practitioner-the-measurement-lab\">SCI for AI Practitioner: The Measurement Lab</a></li><li><a class=\"font-semibold text-primary underline underline-offset-2 hover:no-underline\" href=\"https://academy.greensoftware.foundation/course/software-water-foundations\">Software Water Foundations</a></li></ul>", linkText: "Explore developer courses →", linkHref: "https://academy.greensoftware.foundation/" },
      { badge: "Data and models", title: "Courses for people who work with data and models", description: "Data and ML engineers who work with data pipelines, models, and prompts.", descriptionHtml: "<p>Data and ML engineers who work with data pipelines, models, and prompts.</p><ul class=\"mt-3 list-disc space-y-1.5 pl-4\"><li><a class=\"font-semibold text-primary underline underline-offset-2 hover:no-underline\" href=\"https://academy.greensoftware.foundation/course/green-data-practitioner\">Green Data Practitioner</a></li><li><a class=\"font-semibold text-primary underline underline-offset-2 hover:no-underline\" href=\"https://academy.greensoftware.foundation/course/green-ai-for-ml-practitioners\">Green AI for ML Practitioners</a></li><li><a class=\"font-semibold text-primary underline underline-offset-2 hover:no-underline\" href=\"https://academy.greensoftware.foundation/course/green-ai-prompting-for-self-and-agents\">Green AI Prompting, for Self & Agents</a></li></ul>", linkText: "Explore data and ML courses →", linkHref: "https://academy.greensoftware.foundation/" },
      { badge: "Run", title: "Courses for people who run systems", description: "Platform, SRE, and DevOps teams who operate software and AI in production.", descriptionHtml: "<p>Platform, SRE, and DevOps teams who operate software and AI in production.</p><ul class=\"mt-3 list-disc space-y-1.5 pl-4\"><li><a class=\"font-semibold text-primary underline underline-offset-2 hover:no-underline\" href=\"https://academy.greensoftware.foundation/course/greenops-practitioner\">GreenOps Practitioner</a></li></ul>", linkText: "Explore operations courses →", linkHref: "https://academy.greensoftware.foundation/" },
    ]}
    quote={{
      text: "Those decisions sit across the organization, from the developer writing a query to the executive signing a contract. The Academy gives every role the skills to make those decisions with both environmental and financial impact in view.",
      author: "Navveen Balani",
      role: "Executive Director, Green Software Foundation",
    }}
    ctaLeadIn="The pilot is open to GSF member organizations, who help shape the program around real roles and skills gaps. We recommend starting with Green Software Practitioner and SCI Fundamentals."
    ctaText="Explore the Academy →"
    ctaHref="https://academy.greensoftware.foundation"
    ctaSecondaryText="Become a member →"
    ctaSecondaryHref="/membership/"
  />

  <!-- Section 5: Green Software Patterns -->
  <div id="patterns" class="scroll-mt-24"></div>
  <FeatureGrid
    heading="Put it into practice with Green Software *Patterns*"
    body="Courses teach the principles. Patterns show you what to change. The Green Software Patterns catalog is a free, open-source library of more than 50 peer-reviewed techniques for reducing the emissions of software across AI, cloud, and web. Each pattern describes one concrete change, such as choosing the cloud region closest to your users, and explains how it lowers your Software Carbon Intensity (SCI) score."
    variant="bordered"
    columns={4}
    ctaLeadIn="Browse more than 50 free, peer-reviewed patterns by role or lifecycle stage. Each one shows what to change, why it works, and how it affects your SCI score."
    ctaText="Browse the patterns catalog →"
    ctaHref="https://patterns.greensoftware.foundation"
    features={[
      { icon: "/assets/shape-icon-1.svg", title: "What a pattern is", description: "A short, practical guide to one change. Every pattern follows the same structure: the problem, the solution, its SCI impact, the assumptions behind it, things to consider before applying it, and references." },
      { icon: "/assets/standardized-icon.svg", title: "How to use them", description: "Find patterns for your role, such as DevOps, front-end, AI/ML, or solution architecture, or for your lifecycle stage, from requirements to operations. Review the solution, check how it fits your system, then apply it and measure the result." },
      { icon: "/assets/co2-icon.svg", title: "Why they help", description: "Patterns turn what you learned in the courses into changes you can make this sprint. Each one is reviewed by subject-matter experts from GSF member organizations, and measured: NTT DATA recorded about a 4% carbon reduction from a single pattern.", linkText: "Read the patterns story →", linkHref: "/stories/green-software-patterns/" },
      { icon: "/assets/realtime-icon.svg", title: "Share what works", description: "Found a technique that cuts emissions? Propose it on GitHub. You describe the problem and your approach, and the patterns team helps develop it through expert and community review.", linkText: "Propose a pattern →", linkHref: "https://patterns.greensoftware.foundation/contribute" },
    ]}
  />

  <!-- Section 8: Education stories -->
  <MemberStories
    heading="Education in *action*"
    body="See how our courses and patterns are being used by organizations and educators worldwide."
    stories={[
      {
        title: "Our engineers don't know how to build green software",
        description: "How Goldman Sachs, Avanade, and GSF members worldwide built and scaled the Green Software Practitioner course — now completed by over 145,000 engineers.",
        imageSrc: "/assets/stories/green-software-practitioner.jpg",
        href: "/stories/green-software-practitioner/",
      },
      {
        title: "Engineers know the theory but not what to change in code",
        description: "How NTT DATA, Goldman Sachs, and contributors from 11 organizations built the Green Software Patterns catalog — peer-reviewed techniques with measurable impact.",
        imageSrc: "/assets/stories/green-software-patterns.png",
        href: "/stories/green-software-patterns/",
      },
    ]}
    footerCtaText="View all member stories"
    footerCtaHref="/stories/"
  />

  <!-- Section 9: Learning resources -->
  <ResourceCards
    heading="Learning *resources*"
    body="Beyond our courses, a growing ecosystem of resources to support your green software journey."
    cards={[
      { icon: "/assets/shape-icon-2.svg", title: "Awesome Green Software", description: "A curated list of tools, articles, research papers, and open-source projects in the green software space.", ctaText: "Explore the list", ctaHref: "https://github.com/Green-Software-Foundation/awesome-green-software" },
      { icon: "/assets/shape-icon-3.svg", title: "Environment Variables Podcast", description: "Practitioner-focused conversations with the people building the green software movement.", ctaText: "Listen now", ctaHref: "https://podcast.greensoftware.foundation" },
      { icon: "/assets/shape-icon-1.svg", title: "CXO Bytes Podcast", description: "Bite-sized insights for technology leaders on sustainability, digital transformation, and the business case for green software.", ctaText: "Listen now", ctaHref: "https://podcasts.castplus.fm/cxo-bytes" },
      { icon: "/assets/shape-icon-2.svg", title: "GSF Meetup Network", description: "Join local meetups around the world to connect with green software practitioners in your region, share experiences, and learn together.", ctaText: "Find a meetup", ctaHref: "https://www.meetup.com/pro/gsf/" },
      { icon: "/assets/shape-icon-3.svg", title: "Member Stories", description: "Real-world case studies from organizations applying green software practices — see how GSF members are reducing their environmental impact at scale.", ctaText: "Read the stories", ctaHref: "/stories/" },
    ]}
  />

  <!-- Section 9: For organizations -->
  <FeatureGrid
    heading="Education for *organizations*"
    body="Scaling green software skills across your teams? We offer tailored programs for GSF member organizations."
    variant="bordered"
    columns={2}
    linkStyle="button"
    features={[
      { icon: "/assets/standardized-icon.svg", title: "Cohort-Based Training", description: "Structured learning programs with facilitated sessions, group exercises, and peer discussion. Designed for teams adopting green software practices together. Our first SCI for AI Bootcamp ran for 12 weeks with Amadeus, AVEVA, Schneider Electric, and Siemens.", linkText: "Read about the SCI for AI Bootcamp →", linkHref: "/articles/sci-for-ai-bootcamp-how-four-organizations-are-measuring-their-ai-emissions/" },
      { icon: "/assets/renewable-icon.svg", title: "In-House Licensing", description: "Integrate GSF courses directly into your internal learning platforms. Deliver green software training at scale, on your own schedule.", linkText: "Email Jamie to discuss →", linkHref: "mailto:jamie@greensoftware.foundation?subject=In-house%20licensing%20enquiry" },
      { icon: "/assets/co2-icon.svg", title: "Champions Program", description: "Recognize and empower your most passionate green software advocates. Champions drive adoption from within, supported by the global GSF community.", linkText: "Learn about Champions →", linkHref: "https://champions.greensoftware.foundation" },
      { icon: "/assets/realtime-icon.svg", title: "Become a Member", description: "Education programs are available to GSF member organizations. Membership gives you access to cohort training, in-house licensing, and the full GSF ecosystem.", linkText: "Explore membership →", linkHref: "/membership/" },
    ]}
  />

  <!-- Section 10: Education articles -->
  {educationArticles.length >= 3 && (
    <ArticleCarousel
      heading="Keep learning: articles and blog posts"
      body="Guides, explainers, and reading to take your green software skills further, from measuring software carbon to the latest on the Academy and the standards."
      articles={educationArticles}
      ctaText="View all articles →"
      ctaHref="/articles/"
    />
  )}

  <!-- Section 11: Final CTA -->
  <CTABanner
    heading="Start your green software journey today"
    body="The Green Software Practitioner course is free, self-paced, and takes just a few hours. Join 145,000+ practitioners who've already taken the first step."
    ctaText="Take the free course"
    ctaHref="https://grnsft.org/mov-plat-gs-practitioner"
  />

  <Footer />
</Layout>
