---

<Layout
  title="Partnerships & Recognition — Green Software Foundation"
  description="Governments, intergovernmental bodies and universities working with the Green Software Foundation: from G7 recognition to national adoption of SCI."
>
  <Navbar
    logoSrc="/assets/gsf-logo-full.svg"
    logoAlt="Green Software Foundation"
    logoHref="/"
    topBar="none"
    showSearch
    navItems={navItems}
  />

  <Breadcrumb items={[
    { label: "Home", href: "/" },
    { label: "About", href: "/about/" },
    { label: "Partnerships & Recognition" },
  ]} />

  <Hero
    heading="Partnerships"
    headingAccent="& Recognition"
    body="From the G7 to national digital agencies, the Green Software Foundation's open standards are being cited, adopted and built into public policy. This page brings together the public evidence."
    bgClass="bg-accent-lightest-2"
    imageSrc="/assets/hero-illustration.svg"
    imageAlt="Partnerships and recognition illustration"
  />

  <!-- In-page navigation -->
  <nav aria-label="On this page" class="sticky top-0 z-30 border-b border-primary-lighter bg-white/95 backdrop-blur">
    <div class="container">
      <ul class="flex gap-2 overflow-x-auto py-3 text-sm font-semibold">
        {sections.map((s) => (
          <li class="shrink-0">
            <a href={`#${s.id}`} class="inline-block rounded-full border border-primary-lighter px-4 py-1.5 text-primary-dark transition-colors hover:bg-primary hover:text-white">{s.navLabel}</a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- DRAFT REVIEW KEY: remove before launch -->
  <div class="container my-6">
    <p class="rounded-md border-2 border-dashed border-orange-500 bg-orange-50 p-4 text-sm text-orange-900">
      <strong>Draft review key:</strong> cards marked <strong>UNVERIFIED</strong> come from the source document but lack a confirmed public source. They need verification before this page goes live.
    </p>
  </div>

  {sections.map((s) => (
    <div id={s.id} class="scroll-mt-16">
      <CardGrid
        heading={s.heading}
        body={s.body}
        cards={s.cards}
        columns={3}
        align="left"
        bgClass={s.bg}
      />
      {s.note && <TextBlock body={s.note} compact bgClass={s.bg} />}
    </div>
  ))}

  <CTABanner
    heading="Work with the Green Software Foundation"
    body="Government, non-profit and academic organisations join free of charge. We are a non-profit, vendor-neutral foundation under the Linux Foundation, with standards ratified by consensus and certified by ISO."
    ctaText="Join the Foundation"
    ctaHref="/membership/"
  />

  <Footer />
</Layout>
