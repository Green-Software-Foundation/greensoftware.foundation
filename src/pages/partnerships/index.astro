        "label": "Press",
        "title": "Coverage in the BBC, MIT Technology Review and more",
        "bodyHtml": "Our press page links BBC, MIT Technology Review, Forbes, Raconteur and the Economic Times. <a href='https://www.fortune.com/2021/05/25/microsoft-accenture-goldman-sachs-to-develop-green-software-energy-consumption'>Fortune</a> covered our founding.<span class=\"mt-3 block text-xs font-semibold uppercase tracking-wide text-primary\">Press</span>",
        "tags": [],
        "ctaText": "View source →",
        "ctaHref": "https://greensoftware.foundation/press/"
      }
    ],
    "bg": "bg-accent-lightest-2"
  }
];
---

<Layout
  title="Partnerships & Recognition — Green Software Foundation"
  description="Governments, intergovernmental bodies and universities working with the Green Software Foundation: from G7 recognition to national adoption of SCI."
>
  <Navbar
    logoSrc="/assets/gsf-logo-full.svg"
    logoAlt="Green Software Foundation"
    logoHref="/"
    topBar="none"
    showSearch
    navItems={navItems}
  />

  <Breadcrumb items={[
    { label: "Home", href: "/" },
    { label: "About", href: "/about/" },
    { label: "Partnerships & Recognition" },
  ]} />

  <Hero
    heading="Partnerships"
    headingAccent="& Recognition"
    body="From the G7 to national digital agencies, the Green Software Foundation's open standards are being cited, adopted and built into public policy. This page brings together the public evidence."
    bgClass="bg-accent-lightest-2"
    imageSrc="/assets/hero-illustration.svg"
    imageAlt="Partnerships and recognition illustration"
  />

  <!-- In-page navigation -->
  <nav aria-label="On this page" class="border-b border-primary-lighter bg-white py-6">
    <div class="container">
      <p class="mb-3 text-center text-xs font-bold uppercase tracking-wider text-accent-dark">Jump to</p>
      <ul class="flex flex-wrap justify-center gap-2 text-sm font-semibold">
        {sections.map((s) => (
          <li>
            <a href={`#${s.id}`} data-pill={s.id} class="inline-block rounded-full border border-primary-lighter px-4 py-1.5 text-primary-dark transition-colors hover:bg-primary hover:text-white">{s.navLabel}</a>
          </li>
        ))}
      </ul>
      <p class="mb-3 mt-6 text-center text-xs font-bold uppercase tracking-wider text-accent-dark">Or filter by topic</p>
      <div data-filter-bar class="flex flex-wrap justify-center gap-2 text-sm font-semibold">
        <button type="button" data-filter="all" aria-pressed="true" class="rounded-full border border-primary px-4 py-1.5 text-primary-dark transition-colors hover:bg-primary hover:text-white aria-pressed:bg-primary aria-pressed:text-white">Show all</button>
        {filters.map((f) => (
          <button type="button" data-filter={f.id} aria-pressed="false" class="rounded-full border border-primary px-4 py-1.5 text-primary-dark transition-colors hover:bg-primary hover:text-white aria-pressed:bg-primary aria-pressed:text-white">{f.label}</button>
        ))}
      </div>
      <p data-filter-status aria-live="polite" class="mt-3 text-center text-sm text-primary-dark/70"></p>
    </div>
  </nav>

  <TextBlock heading={intro.heading} body={intro.body} bodyExtra={intro.extra} />

  <!-- DRAFT REVIEW KEY: remove before launch -->
  <div class="container my-6">
    <p class="rounded-md border-2 border-dashed border-orange-500 bg-orange-50 p-4 text-sm text-orange-900">
      <strong>Draft review key:</strong> cards marked <strong>UNVERIFIED</strong> come from the source document but lack a confirmed public source. They need verification before this page goes live.
    </p>
  </div>

  {sections.map((s) => (
    <div id={s.id} data-section class="scroll-mt-4">
      <CardGrid
        heading={s.heading}
        body={s.body}
        cards={s.cards}
        columns={3}
        align="left"
        bgClass={s.bg}
      />
      {s.note && <TextBlock body={s.note} compact bgClass={s.bg} />}
    </div>
  ))}

  <CTABanner
    heading="Work with the Green Software Foundation"
    body="Government, non-profit and academic organisations join free of charge. We are a non-profit, vendor-neutral foundation under the Linux Foundation, with standards ratified by consensus and certified by ISO."
    ctaText="Join the Foundation"
    ctaHref="/membership/"
  />

  <Footer />
  <script is:inline>
(function(){
  var bar=document.querySelector('[data-filter-bar]'); if(!bar) return;
  var btns=[].slice.call(bar.querySelectorAll('button[data-filter]'));
  var cards=[].slice.call(document.querySelectorAll('[data-tags]'));
  var secs=[].slice.call(document.querySelectorAll('[data-section]'));
  var pills=[].slice.call(document.querySelectorAll('a[data-pill]'));
  var status=document.querySelector('[data-filter-status]');
  function apply(f){
    var n=0;
    cards.forEach(function(c){var show=f==='all'||(' '+c.getAttribute('data-tags')+' ').indexOf(' '+f+' ')>-1;c.hidden=!show;if(show)n++;});
    secs.forEach(function(s){var any=s.querySelector('[data-tags]:not([hidden])');s.hidden=!any;});
    pills.forEach(function(p){var s=document.getElementById(p.getAttribute('data-pill'));p.parentElement.hidden=!!(s&&s.hidden);});
    btns.forEach(function(b){var on=b.getAttribute('data-filter')===f;b.setAttribute('aria-pressed',on?'true':'false');});
    if(status) status.textContent=f==='all'?'':'Showing '+n+' item'+(n===1?'':'s')+' for '+(btns.filter(function(b){return b.getAttribute('data-filter')===f;})[0].textContent)+'.';
  }
  bar.addEventListener('click',function(e){var b=e.target.closest('button[data-filter]');if(!b)return;apply(b.getAttribute('data-filter'));
    var first=document.querySelector('[data-section]:not([hidden])'); if(first&&b.getAttribute('data-filter')!=='all'){first.scrollIntoView({behavior:'smooth',block:'start'});}});
})();
</script>
</Layout>
