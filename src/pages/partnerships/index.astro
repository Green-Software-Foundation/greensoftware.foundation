        "bodyHtml": "Our press page links BBC, MIT Technology Review, Forbes, Raconteur and the Economic Times. <a href='https://www.fortune.com/2021/05/25/microsoft-accenture-goldman-sachs-to-develop-green-software-energy-consumption'>Fortune</a> covered our founding.",
        "tags": [],
        "ctaText": "View source",
        "ctaHref": "https://greensoftware.foundation/press/",
        "secondaryCtaText": "Learn more about GSF in the press",
        "secondaryCtaHref": "/press/"
      }
    ],
    "bg": "bg-white"
  }
];
---

<Layout
  title="Partnerships & Recognition — Green Software Foundation"
  description="Governments, intergovernmental bodies and universities working with the Green Software Foundation: from G7 recognition to national adoption of SCI."
>
  <Navbar
    logoSrc="/assets/gsf-logo-full.svg"
    logoAlt="Green Software Foundation"
    logoHref="/"
    topBar="none"
    showSearch
    navItems={navItems}
  />

  <Breadcrumb items={[
    { label: "Home", href: "/" },
    { label: "About", href: "/about/" },
    { label: "Partnerships & Recognition" },
  ]} />

  <Hero
    heading="Partnerships"
    headingAccent="& Recognition"
    body="From the G7 to national digital agencies, the Green Software Foundation's open standards are being cited, adopted and built into public policy."
    ctaLeadIn="Government and academic institutions can join the Foundation for free."
    ctas={[{ text: "Discuss membership", variant: "primary", href: "/membership/enquire/" }]}
    bgClass="bg-accent-lightest-2"
    imageSrc="/assets/partnerships-hero.svg"
    imageAlt="A globe connected to a government building, a university, a policy document and a certification rosette"
  />

  <!-- Section navigation: always visible, not sticky. Every section and topic filter is shown
       in the open; a floating "Show everything" pill appears while a filter is active. -->
  <nav aria-label="On this page" class="border-b border-primary-lighter bg-white">
    <div class="container py-8">
      <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 class="text-xl font-extrabold text-primary-dark md:text-2xl">Navigate to the section of interest</h2>
          <p class="mt-1 text-sm text-primary-dark/80 md:text-base">Jump to a section below, or show only the items on one standard or topic.</p>
        </div>
        <button type="button" data-filter="all" aria-pressed="true" class="self-start rounded-full bg-primary-dark px-4 py-1.5 text-sm font-bold text-white shadow-sm transition-colors hover:bg-primary md:self-auto">Show everything</button>
      </div>
      <div class="mt-6 flex flex-col gap-4 rounded-lg border-2 border-primary-dark bg-accent-lightest-2 p-5 md:flex-row md:items-center md:justify-between">
        <div class="max-w-3xl">
          <p class="text-lg font-extrabold text-primary-dark">Using GSF standards for legislation and reporting?</p>
          <p class="mt-1 text-sm text-primary-dark/80 md:text-base">See where our standards support organisations' legal and regulatory commitments, including CSRD sustainability reporting, the EU AI Act, public procurement and government policy.</p>
        </div>
        <button type="button" data-filter="legislation" aria-pressed="false" class="shrink-0 rounded-full bg-primary-dark px-5 py-2 text-sm font-bold text-white shadow-sm transition-colors hover:bg-primary aria-pressed:ring-4 aria-pressed:ring-primary-lighter">Legislation &amp; reporting</button>
      </div>
      <div class="mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
        {navGroups.map((g) => (
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-accent-dark">{g.title}</p>
            <ul class="mt-2 space-y-1 text-sm font-semibold">
              {g.ids.map((id) => (
                <li>
                  <a href={`#${id}`} data-pill={id} class="inline-block border-b-2 border-transparent py-0.5 text-primary-dark transition-colors hover:border-primary hover:text-primary">{sections.find((x) => x.id === id).navLabel}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div data-filter-bar class="mt-8 border-t border-primary-lighter pt-6">
        <p class="text-xs font-bold uppercase tracking-wider text-accent-dark">Show only a standard or topic</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {filters.map((f) => (
            <button type="button" data-filter={f.id} aria-pressed="false" class="rounded-full bg-white px-4 py-1.5 text-sm font-semibold text-primary-dark shadow-sm ring-1 ring-primary-lighter transition hover:ring-primary aria-pressed:bg-primary-dark aria-pressed:text-white aria-pressed:ring-primary-dark">{f.label}</button>
          ))}
        </div>
        <p class="mt-5 text-xs font-bold uppercase tracking-wider text-accent-dark">In development</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {roadmapFilters.map((f) => (
            <button type="button" data-filter={f.id} aria-pressed="false" class="rounded-full bg-white px-4 py-1.5 text-sm font-semibold text-primary-dark shadow-sm ring-1 ring-primary-lighter transition hover:ring-primary aria-pressed:bg-primary-dark aria-pressed:text-white aria-pressed:ring-primary-dark">{f.label}</button>
          ))}
        </div>
      </div>
      <p data-filter-status aria-live="polite" class="mt-4 text-sm text-primary-dark/70 empty:hidden"></p>
    </div>
  </nav>

  <div data-filter-float hidden class="fixed bottom-5 left-1/2 z-40 flex -translate-x-1/2 items-center gap-4 rounded-full bg-primary-dark py-3 pl-6 pr-3 text-base font-semibold text-white shadow-2xl ring-4 ring-white">
    <span data-filter-float-text></span>
    <button type="button" class="rounded-full bg-white px-5 py-2 font-bold text-primary-dark hover:bg-accent-lightest-2">Show everything</button>
  </div>

  <section class="bg-accent-lightest-2 py-12 md:py-16" aria-labelledby="intro-heading">
    <div class="container">
      <div class="grid gap-10 lg:grid-cols-5 lg:gap-14">
        <div class="lg:col-span-2">
          <p class="text-xs font-bold uppercase tracking-wider text-accent-dark">{intro.eyebrow}</p>
          <h2 id="intro-heading" class="mt-2 text-2xl font-semibold md:text-3xl">
            {intro.heading.split(/(\*[^*]+\*)/g).filter(Boolean).map((part) =>
              part.startsWith("*") ? <span class="font-bold text-primary">{part.slice(1, -1)}</span> : part
            )}
          </h2>
          <p class="mt-4 text-base leading-relaxed md:text-lg">{intro.body}</p>
        </div>
        <dl class="divide-y divide-primary-lighter rounded-lg border border-primary-lighter bg-white lg:col-span-3">
          {intro.terms.map((t) => (
            <div class="grid gap-1 p-5 sm:grid-cols-[11rem_1fr] sm:gap-6">
              <dt>
                <span class="block text-lg font-extrabold text-primary-dark">{t.term}</span>
                <span class="block text-sm text-primary-dark/70">{t.full}</span>
              </dt>
              <dd class="text-base leading-relaxed">{t.def}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- DRAFT REVIEW KEY: remove before launch -->
  <div class="container my-6">
    <p class="rounded-md border-2 border-dashed border-orange-500 bg-orange-50 p-4 text-sm text-orange-900">
      <strong>Draft review key:</strong> cards marked <strong>UNVERIFIED</strong> or <strong>PLACEHOLDER</strong> need verification or content before this page goes live.
    </p>
  </div>

  {sections.map((s) => (
    <div id={s.id} data-section class="scroll-mt-24">
      {s.cta && (
        <section class="bg-primary-dark py-6 md:py-8" data-pagefind-ignore>
          <div class="container flex flex-col items-center gap-4 text-center md:flex-row md:justify-between md:text-left">
            <div class="max-w-3xl">
              <h2 class="text-xl font-extrabold text-white md:text-2xl">{s.cta.heading}</h2>
              <p class="mt-1 text-sm text-white/80 md:text-base">{s.cta.body}</p>
            </div>
            <a href={s.cta.href} class="shrink-0">
              <Button variant="primary-invert">{s.cta.text}</Button>
            </a>
          </div>
        </section>
      )}
      {s.special === "assemblies" ? (
        <FeatureGrid
          variant="panel"
          eyebrow="How GSF standards are made"
          heading="Standards traditionally take far too long. How do you *speed up* their creation?"
          body="Agreeing a standard across competing organisations, time zones and languages has traditionally taken years. Assemblies, powered by Harmony, is GSF's tool for speeding up the specification process: Harmony is an AI-assisted consensus engine that brings hundreds of perspectives together asynchronously, so a consensus design document can take weeks, not years."
          stats={[
            { value: "10 weeks", label: "from a blank page to a consensus design document" },
            { value: "14", label: "experts from 15 organisations in one assembly" },
            { value: "< 3 years", label: "from first draft of SCI to ISO standard" },
          ]}
          columns={3}
          linkStyle="button"
          features={[
            { badge: "The problem", title: "Consensus at scale breaks down", description: "Competitors around one table don't freely share, and the loudest voice dominates. Live meetings disadvantage people in other time zones and languages. Traditional multi-stakeholder processes can take years." },
            { badge: "The tool", title: "Harmony, an AI-assisted facilitator", description: "Harmony can hold the perspectives of hundreds of people at once. AI reads and synthesises; humans rate, validate and cast every vote. Every response is logged, and its inclusion can be verified." },
            { badge: "The result", title: "Consensus in weeks, not years", description: "In one assembly, 14 experts from 15 organisations went from a blank page to a consensus design document in ten weeks. The process is now repeatable across new GSF specifications." },
          ]}
          ctaLeadIn="Every new GSF specification can use the Assembly process. Members help shape the standards they will rely on."
          ctaText="Explore Assemblies →"
          ctaHref="/assemblies/"
          ctaSecondaryText="Read the story →"
          ctaSecondaryHref="/stories/ai-accelerated-consensus/"
        />
      ) : (
        <CardGrid
          heading={s.heading}
          body={s.body}
          cards={s.cards}
          columns={s.cols}
          align="left"
          bgClass={s.bg}
        />
      )}
      {s.explainer && (
        <section class="bg-accent-lightest-2 py-12 md:py-16">
          <div class="container">
            <div class="max-w-3xl">
              <p class="text-xs font-bold uppercase tracking-wider text-accent-dark">{s.explainer.eyebrow}</p>
              <h3 class="mt-2 text-2xl font-semibold md:text-3xl">
                {s.explainer.heading.split(/(\*[^*]+\*)/g).filter(Boolean).map((part) =>
                  part.startsWith("*") ? <span class="font-bold text-primary">{part.slice(1, -1)}</span> : part
                )}
              </h3>
              <p class="mt-4 text-base leading-relaxed md:text-lg">{s.explainer.intro}</p>
            </div>
            <div class="mt-8 grid gap-6 md:grid-cols-3">
              {s.explainer.items.map((it) => (
                <div class="rounded-lg border border-primary-lighter bg-white p-6">
                  <p class="text-xs font-bold uppercase tracking-wider text-accent-dark">{it.tag}</p>
                  <h4 class="mt-1 text-xl font-extrabold text-primary-dark">{it.title}</h4>
                  <p class="mt-3 text-base leading-relaxed">{it.body}</p>
                </div>
              ))}
            </div>
            <p class="mt-8 max-w-3xl text-lg font-semibold text-primary-dark">{s.explainer.closing}</p>
            <a href={s.explainer.ctaHref} class="mt-4 inline-block"><Button variant="primary">{s.explainer.ctaText}</Button></a>
          </div>
        </section>
      )}
      {s.note && <TextBlock body={s.note} compact bgClass={s.bg} />}
    </div>
  ))}

  <!-- Media Coverage: full-width sideways scroller, three cards deep -->
  <section class="bg-white py-16 md:py-24" aria-labelledby="coverage-heading">
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 id="coverage-heading" class="text-3xl md:text-4xl font-extrabold text-primary-dark mb-4">Media <span class="text-primary">Coverage</span></h2>
          <p class="text-lg text-primary-dark/70">
            The Green Software Foundation in the news. <strong class="font-bold text-primary-dark">Scroll sideways to see all {(pressMentions as any[]).length} stories.</strong>
          </p>
        </div>
        <div class="flex items-center gap-2" data-coverage-controls>
          <button type="button" data-coverage-prev aria-label="Scroll media coverage left" class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-dark text-xl font-bold text-white shadow-sm transition hover:bg-primary disabled:cursor-not-allowed disabled:opacity-30">&larr;</button>
          <button type="button" data-coverage-next aria-label="Scroll media coverage right" class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-dark text-xl font-bold text-white shadow-sm transition hover:bg-primary disabled:cursor-not-allowed disabled:opacity-30">&rarr;</button>
        </div>
      </div>
    </div>
    <div class="relative mt-8">
      <div
        data-coverage-scroller
        tabindex="0"
        role="region"
        aria-label="Media coverage, scrolls sideways"
        class="coverage-scroll overflow-x-auto scroll-smooth px-6 pb-5 md:px-10"
      >
        <div class="grid w-max grid-flow-col grid-rows-3 auto-cols-[17rem] gap-4 md:auto-cols-[21rem]">
          {(pressMentions as any[]).map((mention: any) => (
            <a
              href={mention.url}
              target="_blank"
              rel="noopener"
              class="group block rounded-lg border border-border bg-accent-lightest-2 p-5 hover:shadow-lg hover:border-primary-lighter transition-all"
            >
              <div class="flex items-start justify-between gap-2 mb-2">
                <span class="text-xs font-bold text-primary uppercase tracking-wider">{mention.source}</span>
                {mention.date && (
                  <span class="text-xs text-primary-dark/50 whitespace-nowrap">
                    {new Date(mention.date).toLocaleDateString("en-GB", { month: "short", year: "numeric" })}
                  </span>
                )}
              </div>
              <h3 class="text-sm font-bold text-primary-dark group-hover:text-primary transition-colors line-clamp-3">
                {mention.title}
              </h3>
              <div class="mt-3 text-xs text-primary-dark/50 truncate">{new URL(mention.url).hostname}</div>
            </a>
          ))}
        </div>
      </div>
      <div data-coverage-fade aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 flex w-24 items-center justify-end bg-gradient-to-l from-white via-white/80 to-transparent pr-3 text-3xl font-bold text-primary transition-opacity">&rsaquo;</div>
    </div>
  </section>

  <CTABanner
    heading="Work with the Green Software Foundation"
    body="Government, non-profit and academic organisations join free of charge. We are a non-profit, vendor-neutral foundation under the Linux Foundation, with standards ratified by consensus and certified by ISO."
    ctaText="Join the Foundation"
    ctaHref="/membership/"
  />

  <Footer />
  <script is:inline>
(function(){
  var bar=document.querySelector('[data-filter-bar]'); if(!bar) return;
  var btns=[].slice.call(document.querySelectorAll('button[data-filter]'));
  var panel=document.querySelector('[data-filter-panel]'); var toggle=document.querySelector('[data-filter-toggle]');
  function setPanel(open){if(!panel||!toggle)return;panel.hidden=!open;toggle.setAttribute('aria-expanded',open?'true':'false');}
  if(toggle){toggle.addEventListener('click',function(){setPanel(panel.hidden);});}
  document.addEventListener('keydown',function(e){if(e.key==='Escape')setPanel(false);});
  document.addEventListener('click',function(e){if(panel&&!panel.hidden&&!e.target.closest('[data-filter-panel]')&&!e.target.closest('[data-filter-toggle]'))setPanel(false);});
  var cards=[].slice.call(document.querySelectorAll('[data-tags]'));
  var secs=[].slice.call(document.querySelectorAll('[data-section]'));
  var links=[].slice.call(document.querySelectorAll('a[data-pill]'));
  var status=document.querySelector('[data-filter-status]');
  var float=document.querySelector('[data-filter-float]');
  var floatText=document.querySelector('[data-filter-float-text]');
  var current='all';
  function label(f){var b=btns.filter(function(x){return x.getAttribute('data-filter')===f;})[0];return b?b.textContent.trim():'';}
  function inSection(c,id){var s=c.closest('[data-section]');return !!s&&s.id===id;}
  function apply(f){
    current=f; var n=0;
    cards.forEach(function(c){
      var show=f==='all'||(f.indexOf('sec-')===0?inSection(c,f.slice(4)):(' '+c.getAttribute('data-tags')+' ').indexOf(' '+f+' ')>-1);
      c.hidden=!show; if(show)n++;
    });
    secs.forEach(function(s){s.hidden=(f!=='all')&&!s.querySelector('[data-tags]:not([hidden])');});
    btns.forEach(function(b){b.setAttribute('aria-pressed',b.getAttribute('data-filter')===f?'true':'false');});
    var on=f!=='all';
    if(status) status.textContent=on?'Showing '+n+' item'+(n===1?'':'s')+' for '+label(f)+'.':'';
    if(float){float.hidden=!on; if(floatText) floatText.textContent='Showing: '+label(f);}
  }
  document.addEventListener('click',function(e){
    var b=e.target.closest('button[data-filter]'); if(!b) return;
    setPanel(false);
    var f=b.getAttribute('data-filter');
    if(f===current&&f!=='all'){apply('all');return;}
    apply(f);
    if(f!=='all'){var first=document.querySelector('[data-section]:not([hidden])'); if(first) first.scrollIntoView({behavior:'smooth',block:'start'});}
  });
  // Jump links: show the full list again if a filter is on, then scroll to the section.
  links.forEach(function(a){a.addEventListener('click',function(e){
    var t=document.getElementById(a.getAttribute('data-pill'));
    if(t&&current!=='all'){e.preventDefault();apply('all');setTimeout(function(){t.scrollIntoView({behavior:'smooth',block:'start'});},50);}
  });});
  if(float){float.querySelector('button').addEventListener('click',function(){apply('all');window.scrollTo({top:0,behavior:'smooth'});});}
})();
</script>
  <style>
    .coverage-scroll { scrollbar-width: auto; scrollbar-color: var(--color-primary, #2f6b5e) #e5ede9; }
    .coverage-scroll::-webkit-scrollbar { height: 12px; }
    .coverage-scroll::-webkit-scrollbar-track { background: #e5ede9; border-radius: 9999px; }
    .coverage-scroll::-webkit-scrollbar-thumb { background: var(--color-primary, #2f6b5e); border-radius: 9999px; }
  </style>
  <script is:inline>
    (function () {
      var sc = document.querySelector('[data-coverage-scroller]');
      if (!sc) return;
      var prev = document.querySelector('[data-coverage-prev]');
      var next = document.querySelector('[data-coverage-next]');
      var fade = document.querySelector('[data-coverage-fade]');
      function update() {
        var max = sc.scrollWidth - sc.clientWidth;
        var atStart = sc.scrollLeft <= 2;
        var atEnd = sc.scrollLeft >= max - 2;
        if (prev) prev.disabled = atStart;
        if (next) next.disabled = atEnd;
        if (fade) fade.style.opacity = atEnd ? '0' : '1';
        var controls = document.querySelector('[data-coverage-controls]');
        if (controls) controls.hidden = max <= 2;
      }
      function step(dir) { sc.scrollBy({ left: dir * Math.max(sc.clientWidth * 0.8, 280), behavior: 'smooth' }); }
      if (prev) prev.addEventListener('click', function () { step(-1); });
      if (next) next.addEventListener('click', function () { step(1); });
      sc.addEventListener('scroll', update, { passive: true });
      sc.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
      });
      window.addEventListener('resize', update);
      update();
    })();
  </script>
</Layout>
