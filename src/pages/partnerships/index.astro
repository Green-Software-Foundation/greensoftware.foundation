  {
    "special": null,
    "cta": {
      "heading": "Calculated an SCI score?",
      "body": "Governments, institutions and organisations of any size can submit it to GSF for free and receive a certificate.",
      "text": "Explore the programme",
      "href": "/standards/certification/"
    },
    "cols": 3,
    "id": "selfcert",
    "navLabel": "SCI self-certification",
    "heading": "SCI self-certification",
    "body": "Governments, public bodies, institutions and companies can submit their SCI calculation to GSF and receive a GSF-issued certificate for a publicly disclosed score under ISO/IEC 21031:2024. The programme is free and open to any organisation, whatever its size, sector or GSF membership. GSF certifies the disclosure, not the score: the review confirms the submission is complete and detailed enough for others to evaluate, and does not audit the calculation itself.",
    "note": "",
    "cards": [
      {
        "label": "Step 1",
        "title": "Calculate and submit your SCI score",
        "bodyHtml": "Any organisation that has calculated an SCI score can submit a seven-section questionnaire by email. It covers the software, the score and its units, the boundary, the calculation inputs and the measurement period. Submission materials include an applicant guide and an example.",
        "tags": [
          "sci"
        ],
        "ctaText": "See the programme and how to apply",
        "ctaHref": "/standards/certification/",
        "secondaryCtaText": "Learn more about SCI",
        "secondaryCtaHref": "/standards/sci/"
      },
      {
        "label": "Step 2",
        "title": "GSF reviews it and issues a certificate",
        "bodyHtml": "GSF checks the submission is complete, and the Software Standards Working Group then has seven days to sign it off. From submission to certificate usually takes around four weeks.",
        "tags": [
          "sci"
        ],
        "ctaText": "Read the announcement",
        "ctaHref": "/articles/sci-self-certification-a-standardized-way-to-disclose-software-s-carbon-emissions-data/"
      },
      {
        "label": "Step 3",
        "title": "A public record and a shareable badge",
        "bodyHtml": "Approved disclosures are published openly on GitHub so procurement teams, auditors, researchers and regulators can examine the method. The certificate is valid for one year, is renewed with a new submission, and comes with a badge the organisation can share.",
        "tags": [
          "sci"
        ],
        "ctaText": "View published disclosures",
        "ctaHref": "https://github.com/Green-Software-Foundation/certification",
        "secondaryCtaText": "Learn more about SCI",
        "secondaryCtaHref": "/standards/sci/"
      }
    ],
    "bg": "bg-white"
  },
